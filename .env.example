# Copy to .env and adjust as needed:  cp .env.example .env
# Nothing here is a real secret — it's a local-only dev stack.

# ----- Image pins -----
WP_VERSION=6.9
PHP_VERSION=8.3

# ----- Database (MariaDB) -----
DB_NAME=buckleup
DB_USER=buckleup
DB_PASSWORD=buckleup
DB_ROOT_PASSWORD=rootpass
DB_PREFIX=wp_

# ----- WordPress -----
WP_HOME=http://localhost:8080
WP_DEBUG=1

# ----- Published ports (change if they collide locally) -----
HTTP_PORT=8080
ADMINER_PORT=8081
MAILPIT_UI_PORT=8025

# ----- Admin account created by provision.sh -----
WP_ADMIN_USER=admin
# Leave blank to have provision.sh generate one and print it once.
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@buckleupdriving.ca
WP_TITLE="BuckleUp Driving School"

# ----- Mail (dev SMTP -> Mailpit container) -----
SMTP_HOST=mailpit
SMTP_PORT=1025

# ----- Third-party keys (leave blank in dev; real values go in prod secrets) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=

# --- Demo console logins (optional) -----------------------------------------
# Leave blank and seed-console-users-pages.php generates + prints a password for
# each on every run. Set them here (this file's real counterpart, .env, is
# gitignored) if you want stable logins across re-provisions.
# NEVER commit real passwords — both GitHub repos are public.
BU_SEED_STUDENT_PW=
BU_SEED_INSTRUCTOR_PW=
BU_SEED_APPADMIN_PW=
BU_SEED_FARHAD_PW=
BU_SEED_DEMO_PW=
