# Secrets & local config
.env
.env.local
*.local

# Built theme assets (rebuilt by Vite / CI)
wp-content/themes/buckleup/build/
wp-content/themes/buckleup/node_modules/

# WordPress core + uploads are NOT versioned — only our theme & plugin are.
# (WP core lives in the wp-core Docker volume; uploads are runtime data.)
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/object-cache.php
wp-content/advanced-cache.php
wp-content/db.php

# DB / data dumps
wp-data/*.sql
wp-data/media-import/
wp-data/blog-seo/
wp-data/graduates/
*.sqlite

# Generated blog-card SVG intermediates (the rasterized PNGs are committed).
content/blog-cards/*.svg

# QA harness (tests/) — commit the SOURCE only (bin, specs, config, lib,
# playwright.config.js, package.json, parity-matrix.csv, README). The heavy,
# regenerable artifacts are NOT versioned:
#   node_modules   -> `npm install`
#   baseline/      -> `node bin/capture-baseline.js` (pinned live golden master)
#   results/       -> produced by a suite run (diffs, lighthouse json)
tests/node_modules/
tests/baseline/
tests/results/
tests/playwright-report/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
*.log
debug.log
