{
  "name": "buckleup-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BuckleUp custom WordPress theme asset pipeline (Vite + Tailwind v4)",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "verify": "node tests/verify-purge.mjs",
    "test": "node tests/interaction.test.mjs",
    "build:verify": "vite build && node tests/verify-purge.mjs && node tests/interaction.test.mjs",
    "lint:css": "echo 'add stylelint if desired'"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.0.0"
  }
}
