{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "768px", "wideSize": "1280px" },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "hsl(var(--primary))" },
        { "slug": "accent", "name": "Accent", "color": "hsl(var(--accent))" },
        { "slug": "background", "name": "Background", "color": "hsl(var(--background))" },
        { "slug": "foreground", "name": "Foreground", "color": "hsl(var(--foreground))" },
        { "slug": "card", "name": "Card", "color": "hsl(var(--card))" },
        { "slug": "border", "name": "Border", "color": "hsl(var(--border))" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "geist", "name": "Geist", "fontFamily": "Geist, ui-sans-serif, system-ui, sans-serif" },
        { "slug": "geist-mono", "name": "Geist Mono", "fontFamily": "\"Geist Mono\", ui-monospace, monospace" }
      ]
    }
  },
  "styles": {
    "color": { "background": "hsl(var(--background))", "text": "hsl(var(--foreground))" },
    "typography": { "fontFamily": "Geist, ui-sans-serif, system-ui, sans-serif" }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
