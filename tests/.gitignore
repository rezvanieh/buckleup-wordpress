# Heavy / generated QA artifacts — regenerated by the runners, not versioned.
node_modules/
playwright-report/
results/
test-results/

# Baseline screenshots are large binaries. The PINNED baseline is regenerated from the
# live site via `npm run baseline`; the JSON SEO snapshots + headers + sitemap/robots are
# small and CAN be committed for provenance, but the PNGs are ignored by default.
# (If the team decides to pin the golden-master PNGs in git/LFS, remove the next line.)
baseline/**/screens/
baseline/*/latest
baseline/*/LATEST

# Keep the captured SEO/headers/sitemap/robots + manifest for the dated baseline:
!baseline/**/seo/
!baseline/**/headers/
!baseline/**/manifest.json
