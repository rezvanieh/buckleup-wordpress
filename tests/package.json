{
  "name": "buckleup-wp-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Site-parity QA harness: pins a baseline of the LIVE BuckleUp site and visual/SEO-diffs the Dockerized WordPress build against it.",
  "scripts": {
    "baseline": "node bin/capture-baseline.js --target live",
    "baseline:candidate": "node bin/capture-baseline.js --target candidate",
    "visual": "playwright test specs/visual.spec.js",
    "visual:update": "UPDATE_BASELINE=1 playwright test specs/visual.spec.js",
    "seo": "node bin/seo-diff.js",
    "seo:live-selfcheck": "node bin/seo-diff.js --selfcheck",
    "functional": "playwright test specs/functional.spec.js",
    "a11y": "playwright test specs/a11y.spec.js",
    "a11y:baseline": "TARGET=live playwright test specs/a11y.spec.js",
    "verify": "node bin/verify-harness.js",
    "test": "playwright test",
    "install:browsers": "playwright install --with-deps chromium webkit firefox",
    "cwv": "node bin/lighthouse-cwv.js --target candidate",
    "cwv:live": "node bin/lighthouse-cwv.js --target live"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.50.0",
    "axe-core": "^4.12.0",
    "lighthouse": "^13.3.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
}
